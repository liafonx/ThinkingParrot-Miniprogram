<!--miniprogram/pages/collection/collection.wxml-->
<view class="page">
    <view class="unit-bar">
        <view class='align-box' wx:for="{{collection}}" wx:if="{{collection[index].length > 0}}" wx:key="index">
            <view class="unit {{choosed == index?'choosed':' '}}"  data-unit="{{index}}" bindtap="ChangeUnit">{{index}}</view>
        </view>
        <view class="warning" wx:if="{{choosed == 0}}">还没有收藏任何题目哦</view>
    </view>
    <view class="question" wx:for="{{collection[choosed]}}" wx:key="index" bindlongpress="OpenSetting" data-index="{{index}}">
        <view class="question-box">
            <view class="question-text">问题</view>
            <view class="content">{{item.question}}</view>
        </view>
        <view class="answer-box">
            <view class="answer-text">答案</view>
            <view class="content answer-content">{{item.answer}}</view>
        </view>

    </view>
    <view hidden="{{hiddensetting}}">
    <modal class="setting" title="确认删除" bindconfirm="Confirm" bindcancel="Cancel">
    </modal>
  </view>
</view>