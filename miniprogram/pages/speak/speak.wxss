/* pages/speak/speak.wxss */
/* pages/tts2/tts2.wxss */
.page {
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  position: fixed;
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items: center;
}

.ans {
  position: relative;
  margin-bottom: 0.5rem;
  margin-left: 0.7rem;
  margin-right: 0.5rem;
  font-size: 17px;
  word-wrap: break-word;
  text-align: left;
}

.prompt {
  position: fixed;
  top: 300rpx;
  left: 50%;
  width: 190rpx;
  height: 200rpx;
  background: rgb(173, 172, 172);
  border-radius: 20rpx;
  text-align: center;
  /* padding-top: 20px; */
  margin-left: -95rpx;
}

cover-image {
  margin: 30rpx auto;
  width: 80rpx;
  height: 100rpx;
}

.question-bar {
  display: flex;
  align-items:center;
  width: 100%;
  /* flex-wrap: wrap; */
  flex-direction: column;
  justify-content: center;
  margin-top: 2rem;
  /* padding-left: 40px; */
  /* margin-bottom: 1rem; */
}

.question-num-box {
  z-index: 1;
  color: white;
  font-size: 21px;
  display: flex;
  flex-flow: column;
  justify-items: center;
  align-items: center;
  text-align: center;
  width: 2rem;
  height: 2rem;
  border-radius: 1rem;
  background-color: #E8CE67;
  margin-left: -0.2rem;
  margin-right: -0.2rem;
  /* margin-right: 7px; */
}

.question {
  margin-top: 4%;
  padding-left: 1rem;
  min-height: 10%;
  /* margin-bottom: -1rem; */
  margin-left: 1rem;
  margin-right: 1rem;
  font-size: 20px;
  word-wrap: break-word;
  display: flex;
  flex-direction: row;
  justify-items: flex-start;
  align-items: center;
  color: #5e5c63;
  font-weight: 550;
  color: rgb(49, 49, 49);
  /* background-color: blue; */
}

.btn {
  z-index: 1;
  width: 6rem;
  height: 6rem;
  border-radius: 30rem;
  background-color: #e6ce9a;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 0px 8px 1px  #9696966b;
}

.btn-text {
  color: #fff;
  font-size: 20px;
}

.answer-box {
  z-index: 1;
  margin-top: 10%;
  width: 20rem;
  height: 9rem;
  border-radius: 1rem;
  background-color: rgb(241, 241, 241);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 5rem;
  box-shadow: 0px 0px 15px 2px  #9696966b;
}

.correctness-box {
  z-index: 2;
  margin-top: -6.5rem;
  width: 3rem;
  height: 3rem;
  border-radius: 2rem;
  background-color: rgb(241, 241, 241);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 10px 15px 2px  #9696966b;
}

.cb-default {
  background-color: green;
}

.icon {
  width: 70%;
  height: 70%;
}

.icon-next {
  width: 70%;
  height: 70%;
}


.top-box {
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center
}

.index-timer-box {
  margin-bottom: 5%;
  margin-top: 10%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.collect-box {
  width: 33%;
  height: auto;
  display: flex;
  flex-direction: row-reverse;
  justify-content: right;
  /* padding-left: 1rem; */
  align-items: center;
  /* background-color: #67e8d3; */
}

.placeholder {
  width: 33%;
  background-color: beige;
}

.icon-coll {
  padding-right: 2rem;
  width: 2.5rem;
  height: 2.5rem;
}

.btn-box {
  width: 33%;
  display: flex;
  justify-content: center;
  align-items: center;
  /* background-color: aquamarine; */
}

.btom-box{
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-top: 5%;
  margin-bottom:15%;
}

.headpiece-process-right{
  z-index: 0;
  /* position: relative; */
  width: 6rem;
  height: 0.5rem;
  /* margin-right: 14rpx; */
  /* border: 4rpx solid #000; */
  overflow: hidden;
  display: flex;
  flex-direction: row;
  /* background: #ffffff; */
}

.headpiece-process-inner {
  /* position: absolute; */
  top: 0rpx;
  right: 0rpx;
  /* background: #E8CE67; */
  height: 100%;
  border-radius: 5px;
  transition: all 0.3s ease-out;
  orientation: horizontal;
  
}


.headpiece-process-left {
  z-index: 0;
  /* position: relative; */
  width: 6rem;
  height: 0.5rem;
  /* margin-right: 14rpx; */
  /* border: 4rpx solid #000; */
  overflow: hidden;
  display: flex;
  flex-direction: row-reverse;
  /* background: #ffffff; */
  
}

.middle {
  width: 5rem;
  height: 5rem;
  z-index: 0;
  /* width: 5rem;
  height: 5rem; */
  /* background-color: blue; */
  flex: 1;
}
