/* pages/home/home.wxss */
.page-title {
  padding-top: 20rpx;
  padding-left: 40rpx;
  font-size: 16px;
}

.page {
  width: 100%;
  height: 100%;
  /* margin-top: 1REM; */
  /* background-image: "miniprogram\data\Image.jfif"; */
  display: flex;
  flex-direction: column;
  align-items: center;
  /* flex-wrap: wrap; */
  justify-content: center;
}


.flex-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx;
  box-sizing: border-box;
}

.flex-item {
  width: 50%;
  height: 200rpx;
  padding: 20rpx;
  border-radius: 30px;
  box-sizing: border-box;
}

.item {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.item-last {
  flex: 1;
}

#btn-box {
  z-index: 1;
  /* background-color: #4DCF32; */
  margin-top: 7.5rem;
}

.btn {
  z-index: 1;
  /* margin-top: 5rem; */
  width: 9rem;
  height: 9rem;
  border-radius: 30rem;
  background-color: green;
  display: flex;
  justify-content: center;
  align-items: center;
}

.page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.btn-text {
  color: #fff;
  font-size: 20px;
}

.background {
  z-index: -1;
  height: 100%;
}

.detail {
  font-size: 15px;
}

#detail-box {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin-top: 10px;
  align-items: center;
  color: #505050;
}

.levels-box {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

.level-btn {
  width: 5.5rem;
  height: 5.5rem;
  border-radius: 1rem;
  background-color: green;
}

#bottom-panel {
  position: fixed;
  bottom: 1.5vh;
  width: 100%;
  height: 35vh;
  display: flex;
  /* margin-top: 10vh; */
  flex-direction: column;
  justify-content: space-around;
  margin-top: 4.5rem;
}

#text-box {
  text-align: center;
  /* background-color: greenyellow; */
}

.unlocked {
  background-color: #dbc87d;
}

.level-btn {
  margin-top: 25px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.current {
  background-color: #4DCF32;
}

.locked {
  background-color: #7A7A7A;
}

.icon {
  margin-bottom: 10px;
  width: 35%;
  height: 35%;
}

.level-text {
  color: white;
}

.product-list {
  z-index: 2;
  /* margin-top: ; */
  width: 100%;
  /* box-sizing: border-box; */
  display: flex;
  /* width: 50%; */
  /* font-size: 14px; */
  margin-top: 2rem;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.choice-bar {
  z-index: 2;
  position: fixed;
  display: flex;
  width: 100%;
  font-size: 14px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  /* background-color: #fff; */
  /**z-index: 0;**/
}

.chioce-item {
  z-index: 2;
  background-color: #F6F6F6;
  /* width: 50%; */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  width: 100%;
  height: 80rpx;
  font-weight: 700;
  font-size: 17px;
  color: #505050;
  border-top: 1rpx solid #ddd;
  border-bottom: 1rpx solid #ddd;
  /* border-left: 1rpx solid #ddd; */
  /*border-right: 1rpx solid #ddd;*/
}

.icon-chioce {
  margin-left: 1rem;
  height: 40rpx;
  width: 40rpx;
}


.district-list,
.sorting-list,
.filter-list {
  margin-top: 2rpx;
  position: absolute;
  top: 85rpx;
  left: 0;
  width: 100%;
  background-color: rgba(246, 246, 246, 0.5);
  backdrop-filter: blur(8px);
  z-index: 2;
  font-size: 14px;
  border-bottom: 1rpx solid #ddd;
}

.chioce-list-hide {
  z-index: 2;
  display: none !important;
}

.chioce-list-show {
  z-index: 2;
  /**top: 80rpx;**/
  animation: slide 500ms;
}

.sorting-item {
  z-index: 2;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  background-color: rgba(246, 246, 246, 0.5);
  backdrop-filter: blur(8px);
  border-bottom: 1rpx solid #ddd;
}

.mask {
  z-index: 1;
  position: fixed;
  top: 40vh;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(8px);
}