/* pages/results/results.wxss */
.page {
  z-index: 0;
  overflow: hidden;
  padding-top: 4rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* background-color: blueviolet; */
}

.mask {
  padding-top: 10vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: rgb(0, 0, 0, 50);
}

.page-title {
  /* background-color: brown; */
  font-size: 20px;
  margin-bottom: 4rem;
}

.page-head {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* background-color: cadetblue; */
  text-align: center;
}
.page-score {
  width:9rem;
  height: 9rem;
  display: flex;
  justify-content: center;
  align-items: center;
  /* padding-top:40rpx;
  padding-bottom:40rpx; */
  font-size:110rpx;
  color: white;
  background-color: #dbc87d;
  border-radius: 4cm;
}


.score-remark {
  font-size: 18px;
  color: white;
  padding-left: 1rem;
  padding-right: 1rem;
  margin-top: 1.5rem;
  line-height: 2rem;
  /* background-color:rgb(63, 160, 131); */
  /* background-color:rgb(50, 170, 39); */
  background-color: rgb(214, 52, 52);
  border-radius: 0.5rem;
}

.score-good {
  background-color:rgb(50, 170, 39);
}

.score-decent {
  background-color:rgb(63, 160, 131);
}

.page-footer {
  width: 100%;
  /* background-color:firebrick */
  margin-top:60rpx;
  text-align: center;
}
.wrong-btns {
  width: 100%;
  display:flex;
  align-items:center;
  justify-content:space-evenly;
  /* background-color: green; */
  /* margin-top: 60rpx; */
}
.home-btn {
  margin-top: 7rem;
  /* margin-left:20rpx; */
  /* margin-right:20rpx; */
  height:70rpx;
  width: 8rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size:16px;
  border: 2px green solid;
  border-radius: 0.25rem;
  /* background-color: rgb(90, 90, 90); */
  color: green;
  font-weight: 700;
}

.wrong-btn {
  border: 2px rgb(161, 66, 54) solid;
  color: rgb(167, 76, 76);
}

.wrong-text {
  font-size: 18px;
  font-weight: 600;
}

.scroll-box{
  /* bottom: 0; */
  z-index: 2;
  /* position: fixed; */
  white-space: nowrap;
  height: 100%;
  /* background-color: firebrick; */
  /*  */
}

.card-box{
  /* margin-top: 18vh; */
  display: inline-block;
  max-height: 60vh;
}

.card{
  display: flex;
  flex-direction: column;
  /* justify-content: */
  align-items:center;
  box-sizing: border-box;
  height: 60vh;
  width: 80vw;
  margin: 6vh 10vw; 
  /* font-size: 40px; */
  /* background: #3b0707; */
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 1rem;
}

.question {
  width: 80vw;
  height: 18vh;
  /* padding-top: 1vh; */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 1rem 1rem 0 0;
  /* word-wrap: break-word; */
  background-color: rgba(255, 255, 255, 0.5);
  /* outline: solid 1px black; */
}

.question-text {
  width: 70vw;
  height: 18vh;
  /* color: white; */
  /* background-color: black; */
  font-size: 18px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  white-space:pre-line;
  /* background-color: blueviolet; */
  /* margin-top: -20px; */
}


.choosed-answer {
  margin-top: 4vh;
  width: 100%;
  display: flex;  
  /* padding-left: 2vh; */
  flex-direction: column;
  align-items: center;
}

.choosed-text {
  padding-left: 1rem;
  padding-right: 1rem;
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 0.5rem 0.5rem 0 0;
  background-color: rgb(185, 51, 51);
}

.choosed {
  width: 74vw;
  /* height: 10vh; */
  max-height: 20vh;
  padding-left: 4vw;
  padding-top: 2vh;
  padding-bottom: 2vh;
  /* color: white; */
  border: 2px rgb(185, 51, 51) solid;
  background-color: rgba(255, 255, 255, 0.6);
  line-height: 1.7rem;
  display: flex;  
  white-space:pre-line;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  font-size: 16px;
}

.answer-box {
  margin-top: 6vh;
}

.answer-text {
  background-color: rgb(48, 165, 48);
}

.answer {
  border: 2px rgb(48, 165, 48) solid;
  background-color: rgba(255, 255, 255, 0.8);
}

.exit-box {
  z-index: 2;
  position: fixed;
  bottom: 2.5rem;
}

.exit-icon {
  
  width: 3.5rem;
  height: 3.5rem;
}

.mask {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(139, 139, 139, 0.6);
  backdrop-filter: blur(10px);
}