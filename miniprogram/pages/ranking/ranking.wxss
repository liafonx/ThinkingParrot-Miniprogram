/* pages/ranking/ranking.wxss */
.rank-list {
  margin-top: 2rem;
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 7rem;
  /* background: white; */
  /* padding: 0 30rpx; */
}

.rank-list view:nth-child(1) .rank-num-box .num-background {
  background-color: #e6d19a;
  color: white;
}

.rank-list view:nth-child(2) .rank-num-box .num-background {
  background-color: #dbcebd;
  color: white;
}

.rank-list view:nth-child(3) .rank-num-box .num-background {
  background-color: #979797;
  color: white;
}

.users {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-left: 20rpx;
  border-bottom: 2px solid #d4d4d4;
  width: 90%;
  height: 5rem;
  margin-bottom: 1rem;
  border-radius: 0.5rem;
  background-color: #ffffff;

}

.myRanking {
  width: 100%;
  height: 6.5rem;
  position: fixed;
  bottom: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  border-radius: 1rem 1rem 0rem 0rem;
  /* padding-top: 2%; */
  background-color: white;
}

.my-rank {
  /* border-top: 2px solid #d4d4d4; */
  background-color: #f8f8f8;
  border-bottom: 0;
  margin-bottom: 0;
}

.users-right {
  width: 28%;
  /* background-color: #DC143C; */
  margin-left: 2%;
  /* padding: 10rpx 0;  */
}

.users-name {
  /* font-size: 35rpx;
  font-weight: 400; */
  /* display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center; */
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.users-score {
  margin-top: 10rpx;
  font-size: 13px;
  color: gray;
  letter-spacing: 2rpx;
  text-overflow: -o-ellipsis-lastline;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  line-clamp: 3;
  -webkit-box-orient: vertical;
}

.pic-box {
  width: 130rpx;
  height: 130rpx;
}

.profile {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 3rem;
}

.rank-name-box {
  text-align: right;
  width: 15%;
  margin-right: 8%;
  margin-left: 2%;
  color: #686868;
  /* background-color: gold; */
}

.rank-num-box {
  width: 15%;
  height: 100%;

}

.num-background {
  width: 100%;
  height: 60%;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  font-size: 22px;
  font-weight: 800;
  font-style: oblique;
  color: #838383;
  border-radius: 0rem 0.5rem 0rem 3rem;
  background-color: rgb(233, 233, 233);
}


.rank-num {
  /* background-color: aquamarine; */
  padding-bottom: 7%;
}

.rank-text {
  padding-bottom: 18%;
  font-size: 12px;
}

.question {
  width: 85%;
  height: 5rem;
  background-color: white;
  border-radius: 0.5rem;
}

.prompt {
  color: #c4a759;
}

.prompt-s {
  margin-top: 2%;
  color: #686868;
  font-size: 10px;
}