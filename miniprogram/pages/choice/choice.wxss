/* pages/test/test.wxss */
.page {
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  position: fixed;
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items: center;
  /* background-color: blueviolet; */
}

.page__bd {
  padding: 20rpx;
}
.my-choosebox {
  display: block;
  margin-bottom: 20rpx;
}
.toindex-btn {
  margin-top: 20rpx;
  display:inline-block;
  line-height:2.3;
  font-size:13px;
  padding:0 1.34em;
  color:#576b95;
  text-decoration:underline;
}

.question-num-box {
  flex-grow: 0;
  z-index: 2;
  color: white;
  font-size: 21px;
  display: flex;
  flex-flow: column;
  justify-items: center;
  align-items: center;
  text-align: center;
  width: 2rem;
  height: 2rem;
  border-radius: 1rem;
  /* background-color: #E8CE67; */
  margin-left: -0.2rem;
  margin-right: -0.2rem;
  
}

.question {
  flex-grow: 0;
  padding-left: 1rem;
  min-height: 6rem;
  margin-top: 1rem;
  margin-bottom: 1rem;
  margin-left: 1rem;
  margin-right: 1rem;
  font-size: 20px;
  color: #5e5c63;
  font-weight: 550;
  word-wrap: break-word;
  display: flex;
  justify-items: flex-start;
  align-items: center;
  color: rgb(49, 49, 49);
}

.option-box {
  flex-grow: 0;
  width: 100%;
  height: auto;
  margin-top: 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  pointer-events: auto;
}

.option {
  width: 87%;
  height: auto;
  min-height: 3.5rem;
  border-radius: 0.5rem;
  margin-bottom: 1.5rem;
  background-color: rgb(241, 241, 241);
  color: rgb(41, 41, 41);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 0.5rem;
  padding-right: 0.5rem;
  font-size: 16px;
  box-shadow: 0px 0px 8px 1px  #9696966b;
}

.option:active {
  background-color: rgb(206, 206, 206);
}

.right {
  background-color: #02a302;
  color: white;
  box-shadow: 0px 0px 8px 1px  #9696966b;
}

.wrong {
  background-color: #d83636;
  color: white;
  box-shadow: 0px 0px 8px 1px  #9696966b;
}

.option-text {
  font-size: 16px;
}

.btn {
  flex-grow: 0;
  z-index: 1;
  width: 6rem;
  height: 6rem;
  border-radius: 30rem;
  background-color: #e6ce9a;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0px 0px 8px 1px  #9696966b;
}

.btn:active {
  background-color: #e0ca6e;
}

.icon-next {
  width: 70%;
  height: 70%;
}

.collect-box {
  width: 33%;
  height: auto;
  display: flex;
  flex-direction: row-reverse;
  justify-content: right;
  /* padding-left: 1rem; */
  align-items: center;
  /* background-color: #67e8d3; */
}

.placeholder {
  width: 33%;
  background-color: beige;
}

.icon-coll {
  padding-right: 2rem;
  width: 2.5rem;
  height: 2.5rem;
}

.btn-box {
  width: 33%;
  display: flex;
  justify-content: center;
  align-items: center;
  /* background-color: aquamarine; */
}

.btom-box{
  flex-grow: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 4.5rem;
}

.index-timer-box {
  margin-bottom: 1.5rem;
  margin-top: 2rem;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  /* background-color: violet; */
}

.headpiece-process-right{
  z-index: 0;
  /* position: relative; */
  width: 6rem;
  height: 0.5rem;
  /* margin-right: 14rpx; */
  /* border: 4rpx solid #000; */
  overflow: hidden;
  display: flex;
  flex-direction: row;
  /* background: #ffffff; */
}

.headpiece-process-inner {
  /* position: absolute; */
  top: 0rpx;
  right: 0rpx;
  /* background: #E8CE67; */
  height: 100%;
  border-radius: 5px;
  transition: all 0.3s ease-out;
  orientation: horizontal;
  
}


.headpiece-process-left {
  z-index: 0;
  /* position: relative; */
  width: 6rem;
  height: 0.5rem;
  /* margin-right: 14rpx; */
  /* border: 4rpx solid #000; */
  overflow: hidden;
  display: flex;
  flex-direction: row-reverse;
  /* background: #ffffff; */
  
}

.middle {
  width: 5rem;
  height: 5rem;
  /* background-color: blue; */
  flex: 1;
}



